import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist
from std_msgs.msg import String
import keyboard

class Controller (Node):
    def __init__(self):
        super().__init__('controller')

        self.direction_publisher = self.create_publisher(Twist, '/cmd_vel' , 10)
        self.msg = Twist() 

    
    def ManualControl(self, stdscr):

        while rclpy.ok():
            msg = Twist()
            if keyboard.is_pressed('up'):
                self.get_logger().info("Up Arrow Pressed")
                msg.linear.x = 0.9
                msg.angular.z = 0.0
                self.direction_publisher.publish(msg)
            elif keyboard.is_pressed('down'):
                self.get_logger().info("Down Arrow Pressed")
                msg.linear.x = -1.0
                msg.angular.z = 0.0
                self.direction_publisher.publish(msg)
            elif keyboard.is_pressed('left'):  
                self.get_logger().info("Left Arrow Pressed")
                msg.angular.z = 1.0
                msg.linear.x = 0.0
                self.direction_publisher.publish(msg)
            elif keyboard.is_pressed('right'):
                self.get_logger().info("Right Arrow Pressed")
                msg.angular.z = -1.0
                msg.linear.x = 0.0
                self.direction_publisher.publish(msg)
            else:
                msg.angular.z = 0.0
                msg.linear.x = 0.0
                self.direction_publisher.publish(msg)


def main(args=None):
    rclpy.init(args=args)

    controller = Controller()
    rcply


if __name__ == '__main__':
    main()                           
